  "type": "module",
  "scripts": {
    "dev": "node scripts/watch-extension.mjs",
    "build": "node scripts/build-extension.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && node --check dist/chrome/service-worker.js && node --check dist/chrome/content/observer.js",
    "verify": "npm run build && npm run check"
  },
  "dependencies": {
    "@lucide/svelte": "^1.14.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
