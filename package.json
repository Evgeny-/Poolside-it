  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.5",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12"
  }
}
